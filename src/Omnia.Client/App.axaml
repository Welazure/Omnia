<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Omnia.Client"
             x:Class="Omnia.Client.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="OmniaBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="OmniaForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OmniaMutedBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="OmniaSurfaceBrush" Color="#121212" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>