# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (used by the postgres service in docker-compose.yml)
POSTGRES_USER=omnia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omnia

# ASP.NET Core API
# Keep the connection string credentials in sync with the PostgreSQL values above.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=omnia;Username=omnia;Password=change-me
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-bytes
Jwt__Issuer=omnia
Jwt__Audience=omnia-clients

# Browser client origin allowed by CORS (add __1, __2, ... for more origins)
Cors__AllowedOrigins__0=http://localhost:5000

# Host port the API is published on
API_PORT=8080
